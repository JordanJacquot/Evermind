<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evermind" Width="1200" Height="880" MinWidth="1040" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#09080F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" Foreground="#EEEBF7">
  <Window.Resources>
    <!-- Thème « Néon verre », le même que Nevermind : panneaux de verre sombre, accents cyan, violet et magenta -->
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#17FFFFFF" Offset="0"/>
      <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/>
      <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Dégradé de la marque : cyan vers violet -->
    <LinearGradientBrush x:Key="AccentBg" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00E5FF" Offset="0"/>
      <GradientStop Color="#B04BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Boutons : exactement ceux de Nevermind -->
<Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBg}"/>
      <Setter Property="Foreground" Value="#08060F"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <!-- Reflet qui apparaît au survol -->
              <Border x:Name="Shine" CornerRadius="19" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Halo cyan au survol -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Background" Value="#16FFFFFF"/>
      <Setter Property="Foreground" Value="#F2EFFA"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#8000E5FF"/>
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Bouton qui supprime (fenêtre « Êtes-vous sûr ? ») : même forme que les autres, en rouge -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Background" Value="#F04438"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#F04438" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="24,20"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#C9C3DD"/>
      <Setter Property="Margin" Value="4,12,0,6"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#A6A1BC"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Champ de saisie en verre, avec un exemple en gris tant qu'il est vide (le texte de « Tag ») -->
    <Style x:Key="Champ" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2EFFA"/>
      <Setter Property="CaretBrush" Value="#00E5FF"/>
      <Setter Property="SelectionBrush" Value="#00E5FF"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="#14FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="16">
              <!-- Le Padding est appliqué par WPF à l'intérieur de PART_ContentHost : seul l'exemple en gris le reprend -->
              <Grid>
                <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#77718F"
                           Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#55FFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#00E5FF"/>
                <Setter TargetName="B" Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interrupteur -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#3A4355">
              <Border.Background><SolidColorBrush x:Name="TrackBrush" Color="#2EFFFFFF"/></Border.Background>
              <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#EEEBF7" Stroke="#40000000" StrokeThickness="1" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobMove" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#7FF4FF"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#00D9F5" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#2EFFFFFF" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barres de défilement fines et sombres -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#3A3350" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#4A5468"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#00E5FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent" Padding="2">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="30"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Flèches rondes des calendriers -->
    <Style x:Key="BtnRond" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="17"/>
    </Style>
    <!-- Choix en pilule (« Chaque semaine »...) : allumé quand Tag vaut « on » -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="on">
          <Setter Property="Background" Value="{StaticResource AccentBg}"/>
          <Setter Property="Foreground" Value="#08060F"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="BorderBrush" Value="#00FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Un jour du petit calendrier du formulaire : rond, en dégradé quand il est choisi -->
    <Style x:Key="Jour" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,1"/>
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="Foreground" Value="#E4E0F2"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="16"/>
              <Border x:Name="Hover" Background="#24FFFFFF" CornerRadius="16" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.25"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Bouton micro : rond, dégradé de la marque, magenta pendant l'écoute (Tag « ecoute ») -->
    <Style x:Key="BtnMicro" TargetType="Button">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#08060F"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Ellipse x:Name="Disc" Fill="{StaticResource AccentBg}"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="ecoute">
                <Setter TargetName="Disc" Property="Fill">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FF2EB5" Offset="0"/>
                      <GradientStop Color="#B04BFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.7"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Fond : nuit violette et trois lueurs (cyan en haut à gauche, violet au centre, magenta en bas à droite) -->
    <Grid Grid.RowSpan="4" IsHitTestVisible="False">
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C0920" Offset="0"/>
            <GradientStop Color="#06050F" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#4400E5FF" Offset="0"/>
            <GradientStop Color="#0000E5FF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.6,0.35" GradientOrigin="0.6,0.35" RadiusX="0.45" RadiusY="0.45">
            <GradientStop Color="#267A3CFF" Offset="0"/>
            <GradientStop Color="#007A3CFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.92,0.9" GradientOrigin="0.92,0.9" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#44FF2EB5" Offset="0"/>
            <GradientStop Color="#00FF2EB5" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
    <!-- Décor propre au thème (Terminal : lignes d'écran), au-dessus du fond, derrière le reste -->
    <Grid x:Name="BackdropDeco" Grid.RowSpan="4" IsHitTestVisible="False"/>

    <!-- En-tête : logo, nom, et le bouton pour ajouter un rendez-vous à la main -->
    <DockPanel Margin="32,22,32,6">
      <Button x:Name="BtnNouveau" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="+  Nouveau rendez-vous" VerticalAlignment="Center"/>
      <Button x:Name="BtnReglages" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Réglages" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <!-- Mascotte d'un thème personnalisé (themes.ps1) -->
      <Border x:Name="Mascotte" DockPanel.Dock="Right" Height="72" Margin="0,-14,22,-14" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
      <!-- La place du logo dans l'en-tête : le logo lui-même est sur un calque au-dessus, on peut le déplacer (logo.ps1) -->
      <Border x:Name="LogoPlace" Width="54" Height="54" Margin="-4,-6,10,-6" VerticalAlignment="Center"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Evermind" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Greeting" Text="Je me souviens de tout pour toi." Style="{StaticResource Sub}" FontSize="15" Margin="1,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Barre rapide : écrire ou dire son rendez-vous en une phrase -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,12,32,0" Padding="18,14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="InPhrase" Style="{StaticResource Champ}" Tag="Écris ou dis ton rendez-vous : « mardi prochain à 15 h dentiste »" MaxLength="200"/>
          <Grid Grid.Column="1" Margin="14,0,0,0" Width="60" Height="60">
            <Ellipse x:Name="MicHalo" Opacity="0" IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#AAFF2EB5" Offset="0.55"/>
                  <GradientStop Color="#00FF2EB5" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Button x:Name="BtnMicro" Style="{StaticResource BtnMicro}" Content="&#xE720;" ToolTip="Parler (ou Ctrl + Maj + Espace, même en jeu)"/>
          </Grid>
          <Button x:Name="BtnAjouter" Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="Ajouter" IsDefault="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="ApercuLigne" FontSize="14" TextWrapping="Wrap" Margin="6,10,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="FormMessage" FontSize="14" TextWrapping="Wrap" Margin="6,10,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="VoixEtat" Style="{StaticResource Sub}" FontSize="13" Margin="6,8,0,0" Visibility="Collapsed"/>
        <!-- Installation de la dictée, la première fois -->
        <Border x:Name="VoixInstall" Visibility="Collapsed" Margin="0,12,0,0" Background="#1400E5FF" BorderBrush="#5500E5FF" BorderThickness="1" CornerRadius="14" Padding="16,12">
          <DockPanel>
            <Button x:Name="BtnVoixInstall" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Installer la dictée" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button x:Name="BtnVoixPlusTard" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Plus tard" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="VoixInstallTexte" FontSize="14" Foreground="#EEEBF7" TextWrapping="Wrap"/>
              <Border x:Name="VoixBarreFond" Height="6" CornerRadius="3" Background="#22FFFFFF" Margin="0,10,0,0" Visibility="Collapsed">
                <Border x:Name="VoixBarre" HorizontalAlignment="Left" Width="4" CornerRadius="3" Background="{StaticResource AccentBg}"/>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- Nouvelle version d'Evermind : mise à jour en un clic -->
        <Border x:Name="MajBandeau" Visibility="Collapsed" Margin="0,12,0,0" Background="#1AFF2EB5" BorderBrush="#66FF2EB5" BorderThickness="1" CornerRadius="14" Padding="16,12">
          <DockPanel>
            <Button x:Name="BtnMaj" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Mettre à jour" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button x:Name="BtnMajPlusTard" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Plus tard" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Text="✦" FontSize="22" Foreground="#FF2EB5" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="MajTexte" FontSize="14" Foreground="#EEEBF7" TextWrapping="Wrap"/>
              <Border x:Name="MajBarreFond" Height="6" CornerRadius="3" Background="#22FFFFFF" Margin="0,10,0,0" Visibility="Collapsed">
                <Border x:Name="MajBarre" HorizontalAlignment="Left" Width="4" CornerRadius="3" Background="{StaticResource AccentBg}"/>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="32,14,32,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>

      <!-- Calendrier du mois -->
      <Border Style="{StaticResource Card}" Padding="20,16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnAujourdhui" Style="{StaticResource BtnSecondary}" Content="Aujourd'hui" Margin="0,0,10,0"/>
              <Button x:Name="BtnMoisPrec" Style="{StaticResource BtnRond}" Content="‹" ToolTip="Mois d'avant"/>
              <Button x:Name="BtnMoisSuiv" Style="{StaticResource BtnRond}" Content="›" ToolTip="Mois d'après" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="MoisTitre" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>
          <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,4">
            <TextBlock Text="lundi" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="mardi" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="mercredi" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="jeudi" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="vendredi" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="samedi" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="dimanche" Style="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0"/>
          </UniformGrid>
          <UniformGrid x:Name="CalGrille" Columns="7" Rows="6"/>
        </DockPanel>
      </Border>

      <!-- À venir, ou les rendez-vous du jour choisi -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18,8,18">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,12,12">
            <Button x:Name="BtnToutVoir" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Tout voir" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel>
              <TextBlock x:Name="PanneauTitre" Text="À venir" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ListeCompte" Style="{StaticResource Sub}" Margin="1,2,0,0"/>
            </StackPanel>
          </DockPanel>
          <Button x:Name="BtnAjouterJour" DockPanel.Dock="Bottom" Style="{StaticResource BtnSecondary}" Content="+  Ajouter ce jour-là" Margin="0,10,12,0" Visibility="Collapsed"/>
          <Grid>
            <StackPanel x:Name="ListeVide" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,40" Visibility="Collapsed">
              <TextBlock x:Name="ListeVideTitre" Text="Rien de prévu pour l'instant." FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ListeVideTexte" Text="Dis-moi ton premier rendez-vous !" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ListeAVenir" Margin="0,0,12,0"/>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Bas de la fenêtre -->
    <DockPanel Grid.Row="3" Margin="32,14,32,18">
      <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
      <!-- Dessin animé d'un thème personnalisé (themes.ps1) -->
      <Border x:Name="FooterArt" DockPanel.Dock="Right" Margin="0,-6,24,-6" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
      <StackPanel Orientation="Horizontal">
        <!-- Caché pour une copie installée par Mindset : c'est Mindset qui lance Evermind avec Windows (suite.ps1) -->
        <StackPanel x:Name="DemarrageOption" Orientation="Horizontal">
          <CheckBox x:Name="ChkDemarrage" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
          <TextBlock Text="Démarrer avec Windows" Foreground="#EEEBF7" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="(conseillé, pour ne rater aucun rappel)" Style="{StaticResource Sub}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="RaccourciTexte" Style="{StaticResource Sub}" FontSize="13" Margin="28,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <!-- Le logo animé (logo.ps1) : E qui glitche, anneaux qui tournent, halo, balayage. On le glisse où on veut, molette : sa taille, double-clic : à sa place -->
    <Canvas x:Name="LogoCalque" Grid.RowSpan="4">
      <Grid x:Name="LogoHote" Width="84" Height="84" Cursor="SizeAll" ToolTip="Glisse-moi où tu veux · molette : ma taille · double-clic : à ma place"/>
    </Canvas>

    <!-- Formulaire : ajouter ou modifier un rendez-vous à la main. À gauche l'essentiel, à droite les détails (facultatifs). -->
    <Grid x:Name="Formulaire" Grid.RowSpan="4" Visibility="Collapsed">
      <Rectangle x:Name="FormFond" Fill="#C8050410"/>
      <Border Style="{StaticResource Card}" Background="#F2141026" Width="1080" Margin="24,24" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,22,18,20">
        <Border.Effect><DropShadowEffect Color="#7A3CFF" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
        <DockPanel>
          <TextBlock x:Name="FormTitre" DockPanel.Dock="Top" Text="Nouveau rendez-vous" Style="{StaticResource H2}" Margin="0,0,0,4"/>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,14,10,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnFAnnuler" Style="{StaticResource BtnSecondary}" Content="Annuler"/>
              <Button x:Name="BtnFEnregistrer" Style="{StaticResource BtnPrimary}" Content="Ajouter" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="FMessage" FontSize="14" TextWrapping="Wrap" Margin="4,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="C'est quoi ?" Style="{StaticResource Label}"/>
                <TextBox x:Name="FTitre" Style="{StaticResource Champ}" Tag="Dentiste, anniversaire de Léa..." MaxLength="120"/>

                <TextBlock Text="Quelle sorte ?" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="FTypes"/>

                <TextBlock Text="Quel jour ?" Style="{StaticResource Label}"/>
                <DockPanel Margin="0,0,0,4">
                  <Button x:Name="FMoisPrec" DockPanel.Dock="Left" Style="{StaticResource BtnRond}" Content="‹" ToolTip="Mois d'avant"/>
                  <Button x:Name="FMoisSuiv" DockPanel.Dock="Right" Style="{StaticResource BtnRond}" Content="›" ToolTip="Mois d'après"/>
                  <TextBlock x:Name="FMoisTitre" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                </DockPanel>
                <UniformGrid Columns="7" Margin="0,4,0,2">
                  <TextBlock Text="lun" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock Text="mar" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock Text="mer" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock Text="jeu" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock Text="ven" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock Text="sam" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock Text="dim" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
                </UniformGrid>
                <UniformGrid x:Name="FJours" Columns="7" Rows="6"/>

                <TextBlock Text="À quelle heure ? (vide = toute la journée)" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="FHeure" Style="{StaticResource Champ}" Tag="15 h 30" Width="140" MaxLength="30" ToolTip="Laisse vide pour toute la journée"/>
                  <Button x:Name="FJournee" Style="{StaticResource Chip}" Content="Toute la journée" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="FHeureInfo" Style="{StaticResource Sub}" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Ça revient ?" Style="{StaticResource Label}"/>
                <WrapPanel>
                  <Button x:Name="FRepUne" Style="{StaticResource Chip}" Content="Une seule fois"/>
                  <Button x:Name="FRepSemaine" Style="{StaticResource Chip}" Content="Chaque semaine"/>
                  <Button x:Name="FRepMois" Style="{StaticResource Chip}" Content="Chaque mois"/>
                  <Button x:Name="FRepAn" Style="{StaticResource Chip}" Content="Chaque année"/>
                </WrapPanel>
              </StackPanel>

              <!-- Plus de détails : tout est facultatif -->
              <StackPanel Grid.Column="2">
                <TextBlock Text="Plus de détails" Style="{StaticResource Label}" FontSize="16" Foreground="White"/>
                <TextBlock Text="Tout est facultatif. Evermind s'en sert pour te prévenir et te rappeler quoi prendre." Style="{StaticResource Sub}" Margin="4,0,0,4"/>

                <StackPanel x:Name="FFinPanel">
                  <TextBlock Text="Jusqu'à quelle heure ?" Style="{StaticResource Label}"/>
                  <WrapPanel>
                    <TextBox x:Name="FFin" Style="{StaticResource Champ}" Tag="16 h" Width="110" MaxLength="30" Margin="0,0,8,0"/>
                    <Button x:Name="FDuree30" Style="{StaticResource Chip}" Content="30 min" Margin="0,4,6,4"/>
                    <Button x:Name="FDuree60" Style="{StaticResource Chip}" Content="1 h" Margin="0,4,6,4"/>
                    <Button x:Name="FDuree120" Style="{StaticResource Chip}" Content="2 h" Margin="0,4,6,4"/>
                    <TextBlock x:Name="FFinInfo" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                  </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="FDernierPanel" Visibility="Collapsed">
                  <TextBlock Text="Sur plusieurs jours ? Le dernier jour" Style="{StaticResource Label}"/>
                  <WrapPanel>
                    <TextBox x:Name="FDernier" Style="{StaticResource Champ}" Tag="29 octobre" Width="170" MaxLength="40" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FDernierInfo" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                  </WrapPanel>
                </StackPanel>

                <TextBlock Text="Où ?" Style="{StaticResource Label}"/>
                <TextBox x:Name="FLieu" Style="{StaticResource Champ}" Tag="Adresse ou lieu (ex : 12 rue des Lilas, Zénith de Paris)" MaxLength="200"/>

                <TextBlock Text="Avec qui ?" Style="{StaticResource Label}"/>
                <TextBox x:Name="FAvec" Style="{StaticResource Champ}" Tag="Paul, Léa..." MaxLength="200"/>

                <TextBlock Text="Dossiers et fichiers" Style="{StaticResource Label}"/>
                <StackPanel x:Name="FFichiers"/>
                <WrapPanel Margin="0,2,0,0">
                  <Button x:Name="FAjouterDossier" Style="{StaticResource Chip}" Content="📁  Ajouter un dossier…"/>
                  <Button x:Name="FAjouterFichier" Style="{StaticResource Chip}" Content="📄  Ajouter un fichier…"/>
                  <Button x:Name="FTrouverDossier" Style="{StaticResource Chip}" Content="🔍  Trouver le dossier"/>
                </WrapPanel>
                <TextBlock x:Name="FFichiersInfo" Style="{StaticResource Sub}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="2,0,0,6"/>
                <CheckBox x:Name="FOuvrirDebut" Margin="2,4,0,0" Foreground="#C9C3DD" FontSize="13" Content="Les ouvrir tout seul à l'heure du rendez-vous"/>

                <TextBlock Text="Lien (visio, Discord, billet...)" Style="{StaticResource Label}"/>
                <TextBox x:Name="FLien" Style="{StaticResource Champ}" Tag="https://..." MaxLength="500"/>

                <TextBlock Text="Me prévenir" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="FRappels"/>

                <TextBlock Text="À préparer" Style="{StaticResource Label}"/>
                <TextBox x:Name="FPreparer" Style="{StaticResource Champ}" Tag="Une chose par ligne (ex : carte Vitale)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
                <WrapPanel x:Name="FSuggestions" Margin="0,8,0,0"/>

                <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                <TextBox x:Name="FNotes" Style="{StaticResource Champ}" Tag="Tout ce qu'il faut savoir : code d'entrée, étage, idées de cadeau..." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>

                <StackPanel x:Name="FAnnivPanel" Visibility="Collapsed">
                  <TextBlock Text="Année de naissance" Style="{StaticResource Label}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FNaissance" Style="{StaticResource Champ}" Tag="1998" Width="110" MaxLength="4"/>
                    <TextBlock x:Name="FAgeInfo" Style="{StaticResource Sub}" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </StackPanel>
                </StackPanel>

                <WrapPanel Margin="0,16,0,0">
                  <Button x:Name="FImportant" Style="{StaticResource Chip}" Content="★  Important"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Fiche d'un rendez-vous : tous ses détails -->
    <Grid x:Name="Fiche" Grid.RowSpan="4" Visibility="Collapsed">
      <Rectangle x:Name="FicheFond" Fill="#C8050410"/>
      <Border Style="{StaticResource Card}" Background="#F2141026" Width="640" Margin="0,30" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
        <Border.Effect><DropShadowEffect x:Name="FicheLueur" Color="#7A3CFF" BlurRadius="44" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
        <DockPanel>
          <Border x:Name="FicheTete" DockPanel.Dock="Top" CornerRadius="22,22,0,0" Padding="26,22">
            <DockPanel>
              <Border x:Name="FicheRond" Width="72" Height="72" CornerRadius="36" BorderThickness="2" Margin="0,0,18,0" VerticalAlignment="Center">
                <TextBlock x:Name="FicheIcone" FontFamily="Segoe UI Emoji" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FicheSorte" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="FicheTitre" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock x:Name="FicheQuand" FontSize="15" Foreground="#EEEBF7" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,12,26,22">
            <Button x:Name="BtnFicheFait" Style="{StaticResource BtnSecondary}" Content="✓  C'est fait" Margin="0,0,10,0"/>
            <Button x:Name="BtnFicheDupliquer" Style="{StaticResource BtnSecondary}" Content="Dupliquer" Margin="0,0,10,0"/>
            <Button x:Name="BtnFicheSupprimer" Style="{StaticResource BtnSecondary}" Content="Supprimer" Margin="0,0,10,0"/>
            <Button x:Name="BtnFicheModifier" Style="{StaticResource BtnSecondary}" Content="Modifier" Margin="0,0,10,0"/>
            <Button x:Name="BtnFicheFermer" Style="{StaticResource BtnPrimary}" Content="Fermer"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="26,16,12,0">
            <StackPanel x:Name="FicheCorps" Margin="0,0,14,0"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Réglages : la voix d'Evermind -->
    <Grid x:Name="Reglages" Grid.RowSpan="4" Visibility="Collapsed">
      <Rectangle x:Name="ReglagesFond" Fill="#C8050410"/>
      <Border Style="{StaticResource Card}" Background="#F2141026" Width="620" Height="640" Margin="0,24" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26,22,12,22">
        <Border.Effect><DropShadowEffect Color="#7A3CFF" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,14,0">
            <TextBlock Text="Réglages" Style="{StaticResource H2}"/>
            <!-- Onglets -->
            <WrapPanel Margin="0,16,0,6">
              <Button x:Name="OngletSon" Style="{StaticResource Chip}" Content="🎧  Son"/>
              <Button x:Name="OngletVoix" Style="{StaticResource Chip}" Content="🗣  Voix"/>
              <Button x:Name="OngletAssistant" Style="{StaticResource Chip}" Content="✨  Assistant"/>
              <Button x:Name="OngletTheme" Style="{StaticResource Chip}" Content="🎨  Thème"/>
              <Button x:Name="OngletGeneral" Style="{StaticResource Chip}" Content="⚙  Général"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,14,0">
            <Button x:Name="BtnReglagesFermer" Style="{StaticResource BtnPrimary}" Content="Fermer"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,14,0">
              <!-- Son : le casque où Evermind parle, le micro qu'il écoute -->
              <StackPanel x:Name="PanSon">
                <!-- Copie gérée par Mindset (suite.ps1) : le micro et le casque se règlent dans Mindset -->
                <StackPanel x:Name="SonMindset" Visibility="Collapsed">
                  <TextBlock Text="Le micro et le casque" Style="{StaticResource Label}" FontSize="16" Margin="2,10,0,4"/>
                  <TextBlock Text="Le micro et le casque se règlent dans Mindset, pour toute la suite." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,12"/>
                  <Button x:Name="BtnSonMindset" Style="{StaticResource BtnSecondary}" Content="Ouvrir les réglages de Mindset" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="SonChoix">
                <TextBlock Text="Le casque" Style="{StaticResource Label}" FontSize="16" Margin="2,10,0,4"/>
                <TextBlock Text="Là où Evermind te parle (réponses et rappels). Clique sur une sortie pour l'entendre. Ton choix est gardé, même après un redémarrage ; s'il est débranché, Evermind parle sur celle de Windows en attendant." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,12"/>
                <StackPanel x:Name="CasqueChoix"/>
                <TextBlock Text="Le micro" Style="{StaticResource Label}" FontSize="16" Margin="2,22,0,4"/>
                <TextBlock Text="Celui qu'Evermind écoute (dictée et « OK Evermind »). Parle : la barre qui bouge montre le micro qui t'entend. Ton choix est gardé, même après un redémarrage ; s'il est débranché, Evermind y revient dès qu'il est rebranché." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,12"/>
                <StackPanel x:Name="MicroChoix"/>
                </StackPanel>
              </StackPanel>
              <!-- Voix -->
              <StackPanel x:Name="PanVoix" Visibility="Collapsed">
                <TextBlock Text="La voix d'Evermind" Style="{StaticResource Label}" FontSize="16" Margin="2,10,0,4"/>
                <TextBlock Text="Choisis la voix qui te parle (confirmations et rappels). Clique sur une voix pour l'écouter." Style="{StaticResource Sub}" Margin="2,0,0,12"/>
                <StackPanel x:Name="VoixChoix"/>
                <TextBlock x:Name="VoixReglageInfo" Style="{StaticResource Sub}" Margin="2,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
              </StackPanel>
              <!-- Assistant : « OK Evermind » et l'IA -->
              <StackPanel x:Name="PanAssistant" Visibility="Collapsed">
                <TextBlock Text="Réveil par la voix" Style="{StaticResource Label}" FontSize="16" Margin="2,10,0,4"/>
                <DockPanel>
                  <CheckBox x:Name="ChkEveil" DockPanel.Dock="Left" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="2,0,14,0"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Réagir quand je dis « OK Evermind »" Foreground="#EEEBF7" FontSize="14"/>
                    <TextBlock x:Name="EveilEtat" Style="{StaticResource Sub}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="L'assistant" Style="{StaticResource Label}" FontSize="16" Margin="2,22,0,4"/>
                <DockPanel>
                  <Button x:Name="BtnAssistant" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Installer l'assistant" VerticalAlignment="Center" Margin="14,0,0,0"/>
                  <TextBlock x:Name="AssistantEtat" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="2,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
              </StackPanel>
              <!-- Thème : les couleurs de Nevermind, adaptées -->
              <StackPanel x:Name="PanTheme" Visibility="Collapsed">
                <TextBlock Text="Le thème" Style="{StaticResource Label}" FontSize="16" Margin="2,10,0,4"/>
                <!-- Copie gérée par Mindset (suite.ps1) : les 5 thèmes se choisissent dans Mindset -->
                <StackPanel x:Name="ThemeMindset" Visibility="Collapsed" Margin="0,0,0,12">
                  <TextBlock Text="Le thème se règle dans Mindset, pour toute la suite. Les thèmes personnalisés d'Evermind restent ici." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,12"/>
                  <Button x:Name="BtnThemeMindset" Style="{StaticResource BtnSecondary}" Content="Ouvrir les réglages de Mindset" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock x:Name="ThemeTexte" Text="Les couleurs d'Evermind, les mêmes thèmes que Nevermind. Choisis-en un : Evermind se relance pour l'appliquer (quelques secondes), tes rendez-vous et réglages ne changent pas." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,12"/>
                <UniformGrid x:Name="ThemeChoix" Columns="2"/>
                <DockPanel Margin="2,6,0,0">
                  <Button x:Name="BtnThemeAppliquer" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Appliquer et relancer" Visibility="Collapsed" Margin="12,0,0,0"/>
                  <TextBlock x:Name="ThemeInfo" Style="{StaticResource Sub}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Couleurs des rendez-vous" Style="{StaticResource Label}" FontSize="16" Margin="2,22,0,4"/>
                <TextBlock Text="La couleur de chaque sorte de rendez-vous, dans le calendrier, la liste, les fiches et les alertes. Elle reste la même avec tous les thèmes." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                <StackPanel x:Name="CouleursSortes"/>
                <TextBlock Text="Thèmes personnalisés" Style="{StaticResource Label}" FontSize="16" Margin="2,22,0,4"/>
                <TextBlock Text="Un thème personnalisé est un zip (avec pack.json, images, police) : il reste sur ton PC, dans le dossier des thèmes d'Evermind." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                <WrapPanel>
                  <Button x:Name="BtnThemeImporter" Style="{StaticResource BtnSecondary}" Content="Importer un thème (.zip)" Margin="0,0,10,0"/>
                  <Button x:Name="BtnThemeDossier" Style="{StaticResource BtnSecondary}" Content="Ouvrir le dossier"/>
                </WrapPanel>
              </StackPanel>
              <!-- Général -->
              <StackPanel x:Name="PanGeneral" Visibility="Collapsed">
                <TextBlock Text="La croix de la fenêtre" Style="{StaticResource Label}" FontSize="16" Margin="2,10,0,4"/>
                <TextBlock Text="Ce que fait Evermind quand tu cliques sur la croix." Style="{StaticResource Sub}" Margin="2,0,0,10"/>
                <WrapPanel>
                  <Button x:Name="CroixDemander" Style="{StaticResource Chip}" Content="Me demander"/>
                  <Button x:Name="CroixReduire" Style="{StaticResource Chip}" Content="Réduire près de l'horloge"/>
                  <Button x:Name="CroixQuitter" Style="{StaticResource Chip}" Content="Quitter"/>
                </WrapPanel>
                <TextBlock Text="Les dossiers où je cherche" Style="{StaticResource Label}" FontSize="16" Margin="2,22,0,4"/>
                <TextBlock Text="Quand tu notes « réunion avec Monsieur Richard », je cherche ici un dossier à son nom pour le relier au rendez-vous. Je ne regarde que les noms des dossiers, jamais leur contenu, et rien ne sort de ton PC." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                <StackPanel x:Name="DossiersRecherche"/>
                <Button x:Name="BtnDossierRechercheAjouter" Style="{StaticResource Chip}" Content="📁  Ajouter un dossier…" HorizontalAlignment="Left"/>
                <TextBlock Text="Mes horaires de travail" Style="{StaticResource Label}" FontSize="16" Margin="2,24,0,4"/>
                <TextBlock Text="Quand tu dis « je suis du matin lundi et mardi » ou « boulot lundi matin, mardi journée et mercredi soir », j'utilise ces heures." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                <StackPanel x:Name="HorairesTravail"/>
                <!-- Copie installée par Mindset (suite.ps1) -->
                <StackPanel x:Name="ReglagesMindset" Visibility="Collapsed">
                  <TextBlock Text="Mises à jour" Style="{StaticResource Label}" FontSize="16" Margin="2,24,0,4"/>
                  <TextBlock Text="Evermind a été installé par Mindset, le portail de la suite : ses mises à jour passent par Mindset. C'est aussi Mindset qui le lance avec Windows." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                </StackPanel>
                <!-- Dossier de travail (maj.ps1) -->
                <StackPanel x:Name="ReglagesTravail" Visibility="Collapsed">
                  <TextBlock Text="Mises à jour" Style="{StaticResource Label}" FontSize="16" Margin="2,24,0,4"/>
                  <TextBlock Text="Dossier de travail : pas de mise à jour automatique (elle écraserait le code source)." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>    <!-- « Êtes-vous sûr ? » : par dessus tout le reste -->
    <Grid x:Name="Confirmation" Grid.RowSpan="4" Visibility="Collapsed">
      <Rectangle x:Name="ConfirmationFond" Fill="#B0050410"/>
      <Border Style="{StaticResource Card}" Background="#F7141026" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
        <Border.Effect><DropShadowEffect Color="#F04438" BlurRadius="40" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="ConfirmationTitre" Style="{StaticResource H2}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConfirmationTexte" Style="{StaticResource Sub}" FontSize="14" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="BtnConfirmationNon" Style="{StaticResource BtnSecondary}" Content="Annuler" Margin="0,0,10,0"/>
            <Button x:Name="BtnConfirmationOui" Style="{StaticResource BtnDanger}" Content="Supprimer"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- La croix : réduire près de l'horloge ou quitter -->
    <Grid x:Name="Fermer" Grid.RowSpan="4" Visibility="Collapsed">
      <Rectangle x:Name="FermerFond" Fill="#B0050410"/>
      <Border Style="{StaticResource Card}" Background="#F7141026" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
        <Border.Effect><DropShadowEffect Color="#7A3CFF" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="Fermer Evermind ?" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="Réduit, Evermind reste près de l'horloge et continue de te rappeler tes rendez-vous. Quitté, il ne te rappelle plus rien jusqu'à son prochain lancement."/>
          <CheckBox x:Name="ChkFermerRetenir" Margin="0,16,0,0" Foreground="#C9C3DD" FontSize="13" Content="Retenir mon choix (modifiable dans les réglages)"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnFermerAnnuler" Style="{StaticResource BtnSecondary}" Content="Annuler" Margin="0,0,10,0"/>
            <Button x:Name="BtnFermerQuitter" Style="{StaticResource BtnDanger}" Content="Quitter" Margin="0,0,10,0"/>
            <Button x:Name="BtnFermerReduire" Style="{StaticResource BtnPrimary}" Content="Réduire"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
