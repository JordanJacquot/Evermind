<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evermind" Width="1060" Height="780" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#09080F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" Foreground="#EEEBF7">
  <Window.Resources>
    <!-- Thème « Néon verre », le même que Nevermind : panneaux de verre sombre, accents cyan, violet et magenta -->
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#17FFFFFF" Offset="0"/>
      <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/>
      <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Dégradé de la marque : cyan vers violet -->
    <LinearGradientBrush x:Key="AccentBg" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00E5FF" Offset="0"/>
      <GradientStop Color="#B04BFF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBg}"/>
      <Setter Property="Foreground" Value="#08060F"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <!-- Reflet qui apparaît au survol -->
              <Border x:Name="Shine" CornerRadius="23" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Halo cyan au survol -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Background" Value="#16FFFFFF"/>
      <Setter Property="Foreground" Value="#F2EFFA"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,7"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#8000E5FF"/>
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Bouton qui demande confirmation (supprimer) -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="Background" Value="#33FF2E6E"/>
      <Setter Property="BorderBrush" Value="#FF2E6E"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2E6E" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Flèches rondes du calendrier -->
    <Style x:Key="BtnRond" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <!-- Un jour du calendrier : rond, lueur au survol, en dégradé quand il est choisi -->
    <Style x:Key="Jour" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,1"/>
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="Foreground" Value="#E4E0F2"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="16"/>
              <Border x:Name="Hover" Background="#24FFFFFF" CornerRadius="16" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.25"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="24,20"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#C9C3DD"/>
      <Setter Property="Margin" Value="4,12,0,6"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#A6A1BC"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Champ de saisie en verre, avec un exemple en gris tant qu'il est vide (le texte de « Tag ») -->
    <Style x:Key="Champ" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2EFFA"/>
      <Setter Property="CaretBrush" Value="#00E5FF"/>
      <Setter Property="SelectionBrush" Value="#00E5FF"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="#14FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="16">
              <!-- Le Padding est appliqué par WPF à l'intérieur de PART_ContentHost : seul l'exemple en gris le reprend -->
              <Grid>
                <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#77718F"
                           Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#55FFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#00E5FF"/>
                <Setter TargetName="B" Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interrupteur -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#3A4355">
              <Border.Background><SolidColorBrush x:Name="TrackBrush" Color="#2EFFFFFF"/></Border.Background>
              <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#EEEBF7" Stroke="#40000000" StrokeThickness="1" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobMove" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#7FF4FF"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#00D9F5" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#2EFFFFFF" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barres de défilement fines et sombres -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#3A3350" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#4A5468"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#00E5FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent" Padding="2">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="30"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Fond : nuit violette et trois lueurs (cyan en haut à gauche, violet au centre, magenta en bas à droite) -->
    <Grid Grid.RowSpan="3" IsHitTestVisible="False">
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C0920" Offset="0"/>
            <GradientStop Color="#06050F" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#4400E5FF" Offset="0"/>
            <GradientStop Color="#0000E5FF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.6,0.35" GradientOrigin="0.6,0.35" RadiusX="0.45" RadiusY="0.45">
            <GradientStop Color="#267A3CFF" Offset="0"/>
            <GradientStop Color="#007A3CFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.92,0.9" GradientOrigin="0.92,0.9" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#44FF2EB5" Offset="0"/>
            <GradientStop Color="#00FF2EB5" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- En-tête : logo et nom -->
    <DockPanel Margin="32,24,32,8">
      <Image x:Name="Logo" Width="54" Height="54" Margin="0,0,16,0" VerticalAlignment="Center">
        <Image.Effect><DropShadowEffect Color="#00E5FF" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/></Image.Effect>
      </Image>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Evermind" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Greeting" Text="Je me souviens de tout pour toi." Style="{StaticResource Sub}" FontSize="15" Margin="1,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="32,14,32,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="22"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Nouveau rendez-vous -->
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Nouveau rendez-vous" Style="{StaticResource H2}"/>

          <TextBlock Text="C'est quoi ?" Style="{StaticResource Label}"/>
          <TextBox x:Name="InTitre" Style="{StaticResource Champ}" Tag="Dentiste, anniversaire de Léa..." MaxLength="120"/>

          <TextBlock Text="Quel jour ?" Style="{StaticResource Label}"/>
          <DockPanel Margin="0,0,0,4">
            <Button x:Name="BtnMoisPrec" DockPanel.Dock="Left" Style="{StaticResource BtnRond}" Content="‹" ToolTip="Mois d'avant"/>
            <Button x:Name="BtnMoisSuiv" DockPanel.Dock="Right" Style="{StaticResource BtnRond}" Content="›" ToolTip="Mois d'après"/>
            <TextBlock x:Name="MoisTitre" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
          </DockPanel>
          <UniformGrid Columns="7" Margin="0,4,0,2">
            <TextBlock Text="lun" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="mar" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="mer" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="jeu" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="ven" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="sam" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="dim" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center"/>
          </UniformGrid>
          <UniformGrid x:Name="CalJours" Columns="7" Rows="6"/>

          <TextBlock Text="À quelle heure ?" Style="{StaticResource Label}"/>
          <DockPanel>
            <TextBox x:Name="InHeure" Style="{StaticResource Champ}" Tag="15 h 30" Width="130" MaxLength="12" DockPanel.Dock="Left"/>
            <Button x:Name="BtnAjouter" Style="{StaticResource BtnPrimary}" Content="Ajouter" IsDefault="True" Margin="14,0,0,0"/>
          </DockPanel>
          <TextBlock x:Name="FormMessage" FontSize="14" TextWrapping="Wrap" Margin="4,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- À venir -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,22,12,22">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,12,14">
            <TextBlock x:Name="ListeCompte" DockPanel.Dock="Right" Style="{StaticResource Sub}" VerticalAlignment="Bottom"/>
            <TextBlock Text="À venir" Style="{StaticResource H2}"/>
          </DockPanel>
          <Grid>
            <StackPanel x:Name="ListeVide" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,40" Visibility="Collapsed">
              <TextBlock Text="Rien de prévu pour l'instant." FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
              <TextBlock Text="Ajoute ton premier rendez-vous à gauche." Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ListeAVenir" Margin="0,0,12,0"/>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Bas de la fenêtre -->
    <DockPanel Grid.Row="2" Margin="32,16,32,20">
      <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="ChkDemarrage" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
        <TextBlock Text="Démarrer avec Windows" Foreground="#EEEBF7" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="(conseillé, pour ne rater aucun rappel)" Style="{StaticResource Sub}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
